rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRoleInUsersDoc(roleName) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == roleName;
    }

    function isAdmin() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'ADMIN') ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        hasRoleInUsersDoc('ADMIN')
      );
    }

    function isMechanic() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'MECHANIC') ||
        hasRoleInUsersDoc('MECHANIC')
      );
    }

    function isCustomer() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'CUSTOMER') ||
        hasRoleInUsersDoc('CUSTOMER')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOpenDispatchStatus(status) {
      return status in ['SEARCHING', 'PENDING_DISPATCH', 'SEARCHING_FOR_MECHANICS', 'PENDING', 'OPEN'];
    }

    function isUnassignedRequest(data) {
      return (!('assignedMechanicId' in data) || data.assignedMechanicId == null || data.assignedMechanicId == '') &&
        (!('mechanicId' in data) || data.mechanicId == null || data.mechanicId == '');
    }

    // Default: Strictly deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. users
    // Authenticated users can read their own user profile; admins can read all
    // Clients can NEVER escalate to ADMIN or alter disabled flag directly
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        'role' in request.resource.data &&
        (request.resource.data.role == 'CUSTOMER' || request.resource.data.role == 'MECHANIC');
      allow update: if (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'disabled'])) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // 2. customerProfiles
    match /customerProfiles/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow create, update: if isOwner(customerId);
      allow delete: if isAdmin();
    }

    // 3. mechanicProfiles
    // Create: initial registration strictly in PENDING status and offline
    // Update: mechanic can only update non-privileged fields and can only go online when APPROVED
    match /mechanicProfiles/{mechanicId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(mechanicId) &&
        'approvalStatus' in request.resource.data &&
        request.resource.data.approvalStatus == 'PENDING' &&
        (!('isOnline' in request.resource.data) || request.resource.data.isOnline == false) &&
        (!('isBusy' in request.resource.data) || request.resource.data.isBusy == false);
      allow update: if (isOwner(mechanicId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'approvalStatus',
          'rejectionReason',
          'statusReason',
          'verifiedAt',
          'verifiedBy',
          'ratingAverage',
          'ratingCount'
        ]) &&
        (!('isOnline' in request.resource.data) ||
          request.resource.data.isOnline == false ||
          ('approvalStatus' in resource.data && resource.data.approvalStatus == 'APPROVED'))) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // 4. mechanicServiceAreas & serviceCategories
    match /mechanicServiceAreas/{areaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /serviceCategories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 5. serviceRequests
    // Online mechanics can listen in real time for open SEARCHING requests and atomically claim unassigned ones.
    // Once assigned, only the assigned mechanic, customer, or admin can read/update.
    match /serviceRequests/{requestId} {
      allow read: if isAuthenticated() && (
        ('customerId' in resource.data && resource.data.customerId == request.auth.uid) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        ('assignedMechanicId' in resource.data && resource.data.assignedMechanicId == request.auth.uid) ||
        ('mechanicId' in resource.data && resource.data.mechanicId == request.auth.uid) ||
        ('status' in resource.data && isOpenDispatchStatus(resource.data.status)) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        ('customerId' in request.resource.data && request.resource.data.customerId == request.auth.uid) ||
        ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        // Case A: First-come atomic claim of an open, unassigned request
        (
          'status' in resource.data &&
          isOpenDispatchStatus(resource.data.status) &&
          isUnassignedRequest(resource.data) &&
          'assignedMechanicId' in request.resource.data &&
          request.resource.data.assignedMechanicId == request.auth.uid &&
          'status' in request.resource.data &&
          request.resource.data.status in ['ASSIGNED', 'ACCEPTED']
        ) ||
        // Case B: Assigned mechanic advancing job status / completion
        (
          ('assignedMechanicId' in resource.data && resource.data.assignedMechanicId == request.auth.uid) ||
          ('mechanicId' in resource.data && resource.data.mechanicId == request.auth.uid)
        ) ||
        // Case C: Customer updating/cancelling their own request
        (
          ('customerId' in resource.data && resource.data.customerId == request.auth.uid) ||
          ('userId' in resource.data && resource.data.userId == request.auth.uid)
        ) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 6. jobOffers
    // Mechanics can ONLY read offers targeted specifically to their mechanicId
    match /jobOffers/{offerId} {
      allow read: if isAuthenticated() && (
        ('mechanicId' in resource.data && resource.data.mechanicId == request.auth.uid) ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // 7. jobAssignments
    match /jobAssignments/{requestId} {
      allow read: if isAuthenticated() && (
        ('customerId' in resource.data && resource.data.customerId == request.auth.uid) ||
        ('mechanicId' in resource.data && resource.data.mechanicId == request.auth.uid) ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // 8. jobStatusEvents
    match /jobStatusEvents/{eventId} {
      allow read: if isAuthenticated() && (
        ('actorId' in resource.data && resource.data.actorId == request.auth.uid) ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // 9. jobChats and jobMessages
    match /jobChats/{requestId} {
      allow read: if isAuthenticated() && (
        ('customerId' in resource.data && resource.data.customerId == request.auth.uid) ||
        ('mechanicId' in resource.data && resource.data.mechanicId == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        ('mechanicId' in request.resource.data && request.resource.data.mechanicId == request.auth.uid) ||
        ('customerId' in request.resource.data && request.resource.data.customerId == request.auth.uid) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        ('mechanicId' in resource.data && resource.data.mechanicId == request.auth.uid) ||
        ('customerId' in resource.data && resource.data.customerId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /jobMessages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/jobChats/$(requestId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/jobChats/$(requestId)).data.mechanicId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isAuthenticated() &&
          get(/databases/$(database)/documents/jobChats/$(requestId)).data.status == 'OPEN' &&
          (get(/databases/$(database)/documents/jobChats/$(requestId)).data.customerId == request.auth.uid ||
           get(/databases/$(database)/documents/jobChats/$(requestId)).data.mechanicId == request.auth.uid) &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // 10. ratings
    match /ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isCustomer() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 11. deviceTokens
    match /deviceTokens/{tokenId} {
      allow read: if ('userId' in resource.data && isOwner(resource.data.userId)) || isAdmin();
      allow create, update: if isAuthenticated() &&
        'userId' in request.resource.data &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if ('userId' in resource.data && isOwner(resource.data.userId)) || isAdmin();
    }

    // 12. adminAuditLogs
    match /adminAuditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // 13. applicationConfig
    match /applicationConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
